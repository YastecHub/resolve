POSTGRES_USER=resolve
POSTGRES_PASSWORD=change-me
POSTGRES_DB=resolve
BIND_HOST=127.0.0.1
API_PORT=9000
WEB_PORT=5175

# API auth. Generate a secret with: openssl rand -hex 32
AUTH_SECRET=change-me
# The first admin, created when nobody can sign in yet
ADMIN_EMAIL=admin@bank.example
ADMIN_STAFF_ID=100001
ADMIN_NAME=Administrator

# AI profiles (JSON array). Each profile's key goes in AI_KEY_<NAME>
# (upper case, dashes as underscores): gemini-lite -> AI_KEY_GEMINI_LITE.
AI_PROFILES='[{"name":"gemini","label":"Gemini 3 Flash","kind":"hosted","baseUrl":"https://generativelanguage.googleapis.com/v1beta/openai","model":"gemini-3-flash-preview"},{"name":"cloudflare","label":"Workers AI","kind":"hosted","baseUrl":"https://api.cloudflare.com/client/v4/accounts/<account-id>/ai/v1","model":"@cf/meta/llama-3.3-70b-instruct-fp8-fast"}]'
AI_ACTIVE_PROFILE=gemini
AI_KEY_GEMINI=
AI_KEY_CLOUDFLARE=
