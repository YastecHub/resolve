# Copy this file to .env

# Icons. "api" loads icons from the public Iconify API (fine for local development).
# "offline" bundles the icons into the build (use for production and on-premise builds).
VITE_ICONS_MODE=api

# Sign-in. "dev" keeps the staff ID sign-in in a production build, for an API with AUTH_MODE=dev.
# Leave it unset when you use Cloudflare Access. Development builds always use the staff ID sign-in.
VITE_AUTH_MODE=
